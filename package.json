{
  "name": "cognitask",
  "version": "0.1.0",
  "description": "AI-powered task decomposition and intelligent todo management",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --import tsx/esm src/index.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "npx --yes concurrently -n back,front -c blue,green \"npm run dev\" \"npm run dev:frontend\"",
    "build": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx/esm src/db/seed.ts"
  },
  "keywords": [
    "ai",
    "todo",
    "task-management",
    "claude-agent-sdk",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/websocket": "^11.3.0",
    "@vercel/postgres": "^0.10.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.10",
    "supabase": "^2.115.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
