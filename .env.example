DATABASE_URL=./cognitask.db
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# auto (default) tries Groq first, then Gemini, then the Anthropic path below.
# Pin to a single provider with: groq | gemini | anthropic
AI_PROVIDER=auto

# Groq — free tier, fastest, does not train on your data.
# Key: https://console.groq.com/keys   Models: https://console.groq.com/docs/models
# Verify the model id before deploying; Groq deprecates ids regularly.
GROQ_API_KEY=
GROQ_MODEL=moonshotai/kimi-k2-instruct

# Gemini — free-tier fallback for when Groq rate-limits.
# NOTE: Google may use free-tier prompts to improve their products, and the
# chat/suggest paths send your real task titles. Leave GEMINI_API_KEY unset to
# disable the fallback entirely.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic — direct API, or AgentRouter via ANTHROPIC_BASE_URL.
# AgentRouter works locally but fails from a hosted environment; do not rely on
# it in production.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-opus-5
